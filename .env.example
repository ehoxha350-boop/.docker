# Copy this file to .env and replace the example values. Do not commit .env.
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
API_ADMIN_TOKEN=replace-with-a-different-long-random-token
AWS_REGION=us-east-1

# Needed only for Route 53 operations. Prefer a least-privilege AWS identity.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
